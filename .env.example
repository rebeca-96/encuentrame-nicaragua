# ENCUÉNTRAME NICARAGUA - Configuración de Variables de Entorno

# Entorno de Ejecución (development | test | production)
ENVIRONMENT=development

# Clave Secreta para Tokens JWT (Generar con: openssl rand -hex 32)
SECRET_KEY=encuentrame-nicaragua-dev-secret-key-32chars-min-prod-change-this!!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Base de Datos (SQLite por defecto para desarrollo nativo, PostgreSQL para Docker/Producción)
# Local nativo:
DATABASE_URL=sqlite:///./encuentrame_nicaragua.db
# Producción Docker:
# DATABASE_URL=postgresql://encuentrame_user:encuentrame_secure_pass_2026!@localhost:5432/encuentrame_nicaragua

# Redis
REDIS_URL=redis://localhost:6379/0

# Almacenamiento de Archivos y Fotografías
STORAGE_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=5

# Configuración del Frontend Next.js
FRONTEND_URL=http://encuentramenicaragua:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
